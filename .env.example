HOST=0.0.0.0
# local ports differ from identity (gRPC 9090), courier (9091) and gatekeeper (8081) so everything runs on one machine
PORT=9092
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
LOG_ENCODING=console
SERVICE_NAME=dictionary
# local: gRPC reflection on, an http issuer is accepted. Any other value requires an https issuer.
ENV=local

# identity: the iss of its tokens, where it publishes its keys, and the aud of the tokens for this service
DICTIONARY_ISSUER=http://localhost:8080
DICTIONARY_JWKS_URL=http://localhost:8080/.well-known/jwks.json
DICTIONARY_AUTH_AUDIENCE=dictionary
# preferences of the users are kept by identity (gRPC). Dictionary exchanges the token of the request for one for
# DICTIONARY_IDENTITY_AUDIENCE with its own client (policy client -> identity, max depth 2). Without
# DICTIONARY_IDENTITY_ADDR they are the defaults and cannot be changed.
# DICTIONARY_IDENTITY_ADDR=localhost:9090
# DICTIONARY_IDENTITY_INSECURE=true
# DICTIONARY_IDENTITY_AUDIENCE=identity
# DICTIONARY_TOKEN_URL=http://localhost:8080/oauth2/token
# DICTIONARY_CLIENT_ID=dictionary-dev
# DICTIONARY_CLIENT_SECRET=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SSLMODE=disable

# saved words and Anki export (the max below is the default of the setting an administrator changes in the admin app)
DICTIONARY_MAX_SAVED_WORDS=100
# size of a deck of a synchronous export (default of the admin setting "max size of an export") and the most an admin can set
DICTIONARY_EXPORT_MAX_BYTES=3145728
DICTIONARY_EXPORT_MAX_BYTES_CEILING=10485760
# size of a part of an export job (default of the admin setting "max size of an export part", streamed to the browser),
# the most an admin can set (the worker holds about 2-3 times the size while it builds) and the most words packed at once
DICTIONARY_EXPORT_PART_MAX_BYTES=3145728
DICTIONARY_EXPORT_PART_MAX_BYTES_CEILING=52428800
DICTIONARY_EXPORT_JOB_BATCH_MAX=20000
# how long a download link of a deck works (it works once)
DICTIONARY_DECK_LINK_TTL=15m
# default of the admin setting "keep removed words for" (1h to 8760h)
DICTIONARY_EXPORTED_RETENTION=168h
DICTIONARY_CLEANUP_INTERVAL=1h
# hosts a saved audio URL may point to (comma or one per line)
DICTIONARY_AUDIO_HOSTS=api.dictionaryapi.dev,upload.wikimedia.org,ssl.gstatic.com,dictionary.cambridge.org

# card files (PVC in Kubernetes): images in <dir>/images, audio in <dir>/audio. Empty DICTIONARY_FILES_DIR turns
# the image and audio uploads off.
DICTIONARY_FILES_DIR=./.local/files
# DICTIONARY_IMAGE_MAX_BYTES=307200      # largest stored image after the resize
# DICTIONARY_IMAGE_MAX_DIM=1024          # longest side in pixels
# DICTIONARY_IMAGE_MAX_PIXELS=25000000   # larger uploads are refused before decoding
# DICTIONARY_IMAGE_USER_QUOTA=20971520   # default of the setting: bytes of images per user (the admin changes it)
# DICTIONARY_AUDIO_MAX_BYTES=409600      # largest uploaded audio file (at most 716800: the gateway body limit)
# DICTIONARY_AUDIO_USER_QUOTA=10485760   # default of the setting: bytes of audio per user
# DICTIONARY_CONTENT_USER_QUOTA=268435456          # default of the setting: bytes of card content per user
# DICTIONARY_CONTENT_MAX_BYTES_CEILING=262144      # the most an admin can set for the content of one word
# DICTIONARY_CONTENT_USER_QUOTA_CEILING=1073741824 # likewise for the quotas (content, image, audio)
# DICTIONARY_IMAGE_USER_QUOTA_CEILING=1073741824
# DICTIONARY_AUDIO_USER_QUOTA_CEILING=1073741824
# DICTIONARY_UNUSED_FILE_AGE=24h         # an image or audio file no card uses is deleted after this long

# lookups
DICTIONARY_LOOKUP_CACHE_TTL=24h
DICTIONARY_LOOKUP_CACHE_SIZE=2000
DICTIONARY_HTTP_TIMEOUT=10s
DICTIONARY_USER_AGENT=huponx-dictionary/1.0 (+https://github.com/huponx/dictionary)
# machine translation (MyMemory) of English definitions that the Vietnamese Wiktionary lacks
DICTIONARY_VI_FALLBACK_MT=true
# DICTIONARY_FREEDICT_URL=https://api.dictionaryapi.dev/api/v2/entries/en
# DICTIONARY_WIKTIONARY_URL=https://vi.wiktionary.org/w/api.php
# DICTIONARY_MYMEMORY_URL=https://api.mymemory.translated.net/get

# dictionary-worker (make run-worker) reads this same file: it ignores the gRPC and identity settings above and
# listens for /healthz and /readyz on HEALTH_ADDR (the API uses no such port). Local ports 8081 and 8082 belong to
# gatekeeper and courier-worker.
# HEALTH_ADDR=:8083
